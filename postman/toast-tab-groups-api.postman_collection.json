                  "name": "Toast Get Restaurants in a Management Group",
                  "id": "e172990f-86da-4625-8212-5b1cc8e54a42",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "description": "(Required) The Toast GUID of one restaurant location in the management \ngroup.\n",
                        "key": "Toast-Restaurant-External-ID",
                        "value": "<string>"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/groups/:managementGroupGUID/restaurants",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "groups",
                        ":managementGroupGUID",
                        "restaurants"
                      ],
                      "variable": [
                        {
                          "id": "6e3a3f31-2394-445b-aa13-d992db3208a3",
                          "key": "managementGroupGUID",
                          "value": "<string>",
                          "description": "(Required) The GUID of the restaurant management group.\n"
                        }
                      ]
                    },
                    "description": "Returns an array of `Restaurant` objects that are a part of the \nrestaurant management group you specify in the \n`managementGroupGUID` path parameter. Each `Restaurant` object \ncontains the unique Toast platform identifier for the restaurant in \nits `guid` value.\n"
