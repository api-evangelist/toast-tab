          "id": "0766beae-c08c-4b83-b338-78db8277d223",
          "name": "Toast Get Restaurants in a Management Group",
          "request": {
            "name": "Toast Get Restaurants in a Management Group",
            "description": {
              "content": "Returns an array of `Restaurant` objects that are a part of the \nrestaurant management group you specify in the \n`managementGroupGUID` path parameter. Each `Restaurant` object \ncontains the unique Toast platform identifier for the restaurant in \nits `guid` value.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "groups",
                ":managementGroupGUID",
                "restaurants"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "managementGroupGUID",
                  "description": "(Required) The GUID of the restaurant management group.\n"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The Toast GUID of one restaurant location in the management \ngroup.\n",
                "key": "Toast-Restaurant-External-ID",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
          "response": [
            {
              "id": "ac072df4-9bb5-4e06-9632-765e17208258",
              "name": "An array of `Restaurant` objects.\n",
              "originalRequest": {
